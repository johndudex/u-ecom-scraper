{
  "site_slug": "sidley-com",
  "analyzed_products": 1,
  "site_analysis_review": {
    "platform_correct": true,
    "platform": "custom (Next.js + Sitecore JSS CMS)",
    "platform_notes": "Confirmed Next.js SSR with Sitecore JSS backend. __NEXT_DATA__ JSON contains the full page layout data including all person fields. Sitecore item paths like /people, component names like PeopleProfessionalDisclaimer, PeopleSearch, PeopleCommitteeMembers confirm the CMS.",
    "anti_bot_correct": true,
    "anti_bot_notes": "No anti-bot protection confirmed. Direct HTTP works. Cloudflare Turnstile site key present (0x4AAAAAABfTU2_s9c7eq5wc) but no active blocking. OneTrust cookie consent present but not anti-bot.",
    "mechanism_correct": true,
    "mechanism_notes": "http_requests is correct. The pages are server-side rendered (Next.js SSR) and all data is available in the initial HTML response via __NEXT_DATA__ JSON. No JS rendering needed for data extraction.",
    "corrections": [
      "Site analysis identified this as a people directory for a law firm, which is correct. 'Products' in this context are individual attorney/people profiles.",
      "The site uses Coveo for its search functionality (Coveo org: sidleyaustincloud), but search is not needed for scraping individual profile pages — direct HTTP to /en/people/{slug} URLs returns all data.",
      "The __NEXT_DATA__ JSON-LD on individual person pages contains a rich schema.org Person type with name, jobTitle, url, image, sameAs, knowsAbout, worksFor — this is the primary extraction source."
    ],
    "correction_count": 3
  },
  "connectivity": {
    "method_that_worked": "direct_http",
    "proxy_tier": "none",
    "js_rendering_needed": false,
    "notes": "Direct HTTP works without proxy or browser. Next.js SSR provides all data in initial HTML response. __NEXT_DATA__ script tag contains the complete page layout and field data."
  },
  "extraction_methods": {
    "primary": "structured_data",
    "structured_data_available": true,
    "structured_data_fields": [
      "title",
      "url",
      "image",
      "job_title",
      "social_links",
      "practices",
      "firm_name"
    ],
    "secondary": "next_data_json",
    "next_data_json_available": true,
    "next_data_json_fields": [
      "first_name",
      "last_name",
      "middle_name",
      "prefix",
      "suffix",
      "email",
      "phone",
      "phone2",
      "phone3",
      "phone4",
      "mobile_phone",
      "pronouns",
      "photo",
      "offices",
      "practices_preview",
      "services",
      "spoken_languages",
      "education",
      "court_admissions",
      "not_admitted_disclaimer",
      "vanity_url",
      "biography",
      "experience",
      "community_involvement",
      "credentials",
      "linkedin_url",
      "vcard_url",
      "level"
    ],
    "notes": "JSON-LD provides Person schema with key fields. __NEXT_DATA__ provides the complete data set from Sitecore JSS. For the people listing page, __NEXT_DATA__ contains PeopleSearch component with Coveo search criteria and committee member data. For individual person pages, the PeopleProfessionalDisclaimer component has all profile fields."
  },
  "fields": {
    "title": {
      "description": "Person's full name (display name)",
      "method": "structured_data",
      "selector": "JSON-LD Person.name or meta og:title",
      "css_fallback": "h1 (first heading in main content)",
      "next_data_path": "PeopleProfessionalDisclaimer fields: combine firstName.value + ' ' + lastName.value",
      "js_extraction": "document.querySelector('h1')?.textContent.trim()",
      "tested": true,
      "examples": ["Yvette Ostolaza"],
      "expectations": {
        "type": "text",
        "required": true,
        "min_length": 2,
        "should_not_match": ["^page not found", "^404", "^oops", "^error", "^not found", "^redirect", "^people \\|", "^people$"],
        "sample_values": ["Yvette Ostolaza"],
        "known_bad_values": ["undefined", "null", "", "People | Sidley Austin LLP", "Page Not Found"],
        "format_hint": "Full person name, e.g. 'Yvette Ostolaza', 'John Smith'"
      }
    },
    "first_name": {
      "description": "Person's first/given name",
      "method": "next_data_json",
      "next_data_path": "PeopleProfessionalDisclaimer.fields.firstName.value",
      "tested": true,
      "examples": ["Yvette"],
      "expectations": {
        "type": "text",
        "required": false,
        "min_length": 1,
        "should_not_match": [],
        "sample_values": ["Yvette"],
        "known_bad_values": ["undefined", "null", ""],
        "format_hint": "First name text, e.g. 'Yvette'"
      }
    },
