# Django
SECRET_KEY=change-me-to-a-random-secret-key-at-least-50-chars
DB_PASSWORD=scraper-db-password
DEBUG=True
DEBUG_AUTO_LOGIN=False
DJANGO_SUPERUSER_PASSWORD=admin

# Celery
REDIS_URL=redis://redis:6379/0

# OpenCode Server
OPENCODE_URL=http://opencode:4096
OPENCODE_PASSWORD=opencode-server-password
OPENCODE_USERNAME=opencode

# ZAI / LLM Provider
ZAI_API_KEY=your-zai-api-key-here

# LiteLLM proxy (optional — code_writer routing, see docs/codewriter-litellm-plan.md)
# Route code_writer through the proxy: CODE_WRITER_MODEL=litellm/standardcompute
# (docker-compose worker). The litellm/ prefix IS the kill switch.
LITELLM_BASE_URL=https://llm.johnjf.xyz/v1
LITELLM_API_KEY=
LITELLM_ENABLED=true
# CODE_WRITER_MODEL=litellm/standardcompute
# CODE_WRITER_LLM_TIMEOUT=600

# Bright Data Proxy - Datacenter
PROXY_DATACENTER_HOST=brd.superproxy.io
PROXY_DATACENTER_PORT=22225
PROXY_DATACENTER_USER=
PROXY_DATACENTER_PASS=

# Bright Data Proxy - Residential
PROXY_RESIDENTIAL_HOST=brd.superproxy.io
PROXY_RESIDENTIAL_PORT=22225
PROXY_RESIDENTIAL_USER=
PROXY_RESIDENTIAL_PASS=
