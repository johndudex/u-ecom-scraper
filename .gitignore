workspace/
logs/
*.log

# Temp & downloads
temp/
downloaded_files/

# Scraper artifacts are File-Master-only (FM-authoritative input_urls since the
# Jul-28 migration) — nothing under scrapers/ is tracked. The local dir stays
# on disk for re-scrapes (check_tracker resume) and FM seeding
# (scripts/seed_fm_input_urls.py).
scrapers/

# Sensitive session cookies
data/akamai-cookies/

# Django collected static
webapp/staticfiles/

# Databases
*.db
*.sqlite3

# Binary
opencode-binary

# Scripts data
scripts/sites_fixture.json

# OS
.DS_Store
Thumbs.db

# Agent loop state
.ralph/

# UI design screenshots
screenshot/

# Temp directories and scripts
tmp/
tmp_*.py

# Webapp nested caches/debris
webapp/workspace/
webapp/downloaded_files/
webapp/.pytest_cache/
webapp/.ruff_cache/
app/workspace/

# Debug scripts
scripts/test_nav_*.py

# Timestamped backup snapshots (e.g. foo.bak.1784232811/)
*.bak.*/

# CloakBrowser runtime .pth patch
cloak_stealth.pth
shared-data/
